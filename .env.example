# Copiar a .env y completar. NUNCA poner valores reales en este archivo.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Transcripción de audio/video sin subtítulos
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-transcribe
# Voz de la guardiana en el chat: voz integrada (marin, coral...) o ID voice_... de una voz personalizada
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin

# Qdrant: local (docker compose) o Qdrant Cloud para compartir entre equipos
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aula_sama_chunks

# Registro de fuentes (PostgreSQL local o gestionado, p. ej. Supabase/Neon)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aula_sama

# Almacenamiento de originales: "local" o "s3" (cualquier S3-compatible: Supabase Storage, R2, MinIO)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Modelos
EMBEDDING_MODEL=voyage-4
SPARSE_MODEL=Qdrant/bm25

# Imágenes e infografías → Markdown con Claude
VISION_MODEL=claude-opus-5-5
VISION_EFFORT=low

# OCR de PDFs escaneados (RapidOCR, modelo latino)
OCR_DPI=300

# Retrieval y evidence gate (scores del reranker 0-1; provisionales)
RERANK_MODEL=rerank-3
RERANK_TOP_K=6
EVIDENCE_MIN_TOP_SCORE=0.75
EVIDENCE_MIN_CHUNK_SCORE=0.5

# Chat
CHAT_MODEL=claude-opus-5-5
CLASSIFY_EFFORT=low
ANSWER_EFFORT=medium

# Chunking (aprox. 4 caracteres por token en español)
CHUNK_TARGET_TOKENS=650
CHUNK_OVERLAP_TOKENS=80

# Pantalla de administración
ADMIN_PASSWORD=

# Límites de uso del chat
MAX_INPUT_CHARS=1000
MAX_TURNS_PER_CONVERSATION=30
MAX_MESSAGES_PER_MINUTE=8
